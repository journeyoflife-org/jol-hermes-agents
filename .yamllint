extends: default

rules:
  line-length:
    max: 120
    level: warning
  comments:
    min-spaces-from-content: 1
  document-start: disable
  braces:
    min-spaces-inside: 1         # inline field style used in memory/schema.yaml
    max-spaces-inside: 1
  truthy:
    allowed-values: ["true", "false", "on"]
  indentation:
    spaces: 2
    indent-sequences: consistent

ignore: |
  .venv/
