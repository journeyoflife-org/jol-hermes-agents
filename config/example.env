# Copy to .env at the repo root and fill in real values.
# .env is git-ignored and secret-scanned; NEVER commit real values.

# LLM providers (EU-only chain, see config/model-routing.yaml)
HERMES_PRIMARY_API_KEY=
HERMES_FALLBACK_API_KEY=

# Messaging gateways
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_ALLOWED_CHAT_IDS=

# Memory store
# Production: absolute path on a persistent volume (audit finding M6).
# Local development alternative: ./runtime/hermes-memory.sqlite
HERMES_MEMORY_PATH=/var/lib/hermes/hermes-memory.sqlite

# Bitrix24 integration (see skills/bitrix/)
BITRIX24_BASE_URL=
BITRIX24_WEBHOOK_TOKEN=
